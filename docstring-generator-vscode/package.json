{
  "name": "docstring-generator-vscode",
  "displayName": "docstring-generator-vscode",
  "description": "Auto-generate docstrings from type hints using docstring-generator",
  "publisher": "FelixTheC",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.125.0"
  },
  "extensionDependencies": [
    "ms-python.python"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "categories": [
    "Formatters",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/FelixTheC/docstring_generator"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "docstring-generator.generateFile",
        "title": "Generate Docstrings"
      }
    ],
    "configuration": {
      "properties": {
        "docstringGenerator.style": {
          "type": "string",
          "enum": [
            "numpy",
            "google",
            "rest"
          ],
          "default": "numpy"
        }
      }
    },
    "keybindings": [
      {
        "command": "docstring-generator.generateFile",
        "key": "ctrl+shift+d",
        "when": "editorLangId == python"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
